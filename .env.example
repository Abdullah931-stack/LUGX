# ==============================================================================
# LUGX Platform - Environment Variables Template
# Copy this file to .env and fill in the actual configuration values.
# NEVER commit the .env file containing real secrets to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Application Configuration
# ------------------------------------------------------------------------------
# Base URL for the client and server redirects (OAuth callbacks, Stripe redirects)
# Development: http://localhost:3000
# Production: https://yourdomain.com
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# 2. Database Configuration (PostgreSQL / Neon Serverless)
# ------------------------------------------------------------------------------
# Pooled connection string with SSL enabled
# Example: postgresql://user:password@ep-example.region.aws.neon.tech/lugx?sslmode=require
DATABASE_URL=postgresql://user:password@ep-example.region.aws.neon.tech/lugx?sslmode=require

# ------------------------------------------------------------------------------
# 3. Supabase Authentication & Client Configuration
# ------------------------------------------------------------------------------
# Project URL found in Supabase Dashboard -> Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Public Anonymous API Key for browser & client requests
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.example_anon_key

# ------------------------------------------------------------------------------
# 4. Stripe Payment & Subscription Configuration
# ------------------------------------------------------------------------------
# Stripe Secret API Key (Use sk_test_... for development, sk_live_... for production)
STRIPE_SECRET_KEY=sk_test_51...

# Stripe Webhook Signing Secret (Starts with whsec_...)
# Local testing: Generated by `stripe listen --forward-to localhost:3000/api/stripe/webhook`
# Production: Found in Stripe Dashboard -> Webhooks -> Signing secret
STRIPE_WEBHOOK_SECRET=whsec_...

# Stripe Publishable Key (Client-side checkout integration)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_51...

# Stripe Price IDs for Subscription Tiers (Monthly recurring prices created in Stripe Dashboard)
# Pro Plan: $12.00/month
STRIPE_PRO_PRICE_ID=price_pro_example_id

# Ultra Plan: $120.00/month
STRIPE_ULTRA_PRICE_ID=price_ultra_example_id

# ------------------------------------------------------------------------------
# 5. Upstash Redis Configuration (Key Rotation & Quota State)
# ------------------------------------------------------------------------------
# Upstash REST URL and Token from Upstash Console (https://console.upstash.com)
UPSTASH_REDIS_REST_URL=https://example-endpoint.upstash.io
UPSTASH_REDIS_REST_TOKEN=AX_example_upstash_rest_token

# ------------------------------------------------------------------------------
# 6. Google Gemini AI Keys & Dynamic Key Rotation
# ------------------------------------------------------------------------------
# Provide at least GEMINI_KEY_1. Additional keys are automatically rotated upon hitting rate limits (429) or quotas.
GEMINI_KEY_1=AIzaSy_example_gemini_key_1
GEMINI_KEY_2=AIzaSy_example_gemini_key_2
GEMINI_KEY_3=AIzaSy_example_gemini_key_3
GEMINI_KEY_4=
GEMINI_KEY_5=
GEMINI_KEY_6=
GEMINI_KEY_7=
GEMINI_KEY_8=
GEMINI_KEY_9=
GEMINI_KEY_10=

# Number of requests per key before rotating to the next key (Default: 20)
GEMINI_REQUESTS_PER_KEY=20

# ------------------------------------------------------------------------------
# 7. Scheduled Tasks & Maintenance (Cron Protection)
# ------------------------------------------------------------------------------
# Shared secret for authenticating automated cron jobs (e.g., /api/cron/purge-deleted)
# Generate a strong random string (e.g. `openssl rand -hex 32`)
CRON_SECRET=your_generated_cron_secret_token_here
