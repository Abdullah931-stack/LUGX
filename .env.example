# LUGX — Environment Configuration Reference
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.

# ---------------------------------------------------------------------------
# Database (PostgreSQL)
# ---------------------------------------------------------------------------
# Production: Neon / any Postgres provider. Test suite uses a local Postgres
# at localhost:5432 (see `.env.test` + `drizzle.config.test.ts`).
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE

# ---------------------------------------------------------------------------
# Supabase (auth)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# ---------------------------------------------------------------------------
# Stripe
# ---------------------------------------------------------------------------
# Live keys must use sk_live_/whsec_live_ prefixes. The webhook endpoint
# must be registered in the Stripe Dashboard with the exact secret below.
STRIPE_SECRET_KEY=sk_test_x
STRIPE_WEBHOOK_SECRET=whsec_x

# ---------------------------------------------------------------------------
# AI quota & Gemini (see src/lib/ai)
# ---------------------------------------------------------------------------
GOOGLE_GENERATIVE_AI_API_KEY=AIza_x
# Comma-separated list of rotation keys (optional):
# GOOGLE_GENERATIVE_AI_KEYS=AIza_x,AIza_y

# ---------------------------------------------------------------------------
# Upstash Redis (rate limiting + AI key rotation counters)
# ---------------------------------------------------------------------------
UPSTASH_REDIS_REST_URL=https://your-app.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-token

# ---------------------------------------------------------------------------
# Cron jobs (purge-deleted retention + quota reset)
# ---------------------------------------------------------------------------
# REQUIRED: a long random secret shared only with your scheduler.
# The cron route (/api/cron/purge-deleted) rejects any request without it:
#   Authorization: Bearer $CRON_SECRET
# Generate with: openssl rand -base64 32
CRON_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET

# Public base URL of your deployment — used by schedulers to hit the cron
# route. Update it whenever the deployment domain changes.
NEXT_PUBLIC_APP_URL=https://your-app.vercel.app

# ---------------------------------------------------------------------------
# Cron scheduling reference
# ---------------------------------------------------------------------------
# Option A — Vercel Cron (add to vercel.json):
#   "crons": [{ "path": "/api/cron/purge-deleted", "schedule": "0 3 * * *" }]
# Option B — GitHub Actions schedule (see .github/workflows/cron.yml):
#   Runs daily at 03:00 UTC via the workflow file in this repository.
# Option C — any external scheduler (cron tab, cron-job.org, etc.):
#   curl -fsS -H "Authorization: Bearer $CRON_SECRET" \
#        https://$NEXT_PUBLIC_APP_URL/api/cron/purge-deleted
# Recommended cadence: daily. Each run deletes at most 500 rows, so the
# endpoint is safe to call more often during catch-up purges.
